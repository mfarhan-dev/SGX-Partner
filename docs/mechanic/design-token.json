  "typography": {
    "fontFamily": {
      "default": "Roboto",
      "urduFallback": "Noto Nastaliq Urdu",
      "mono": "Roboto Mono"
    },
    "usage": {
      "screenTitle": {"size": 24, "lineHeight": 32, "weight": 600},
      "sectionTitle": {"size": 16, "lineHeight": 24, "weight": 600},
      "balanceHero": {"size": 32, "lineHeight": 40, "weight": 700},
      "rewardResult": {"size": 40, "lineHeight": 48, "weight": 700},
      "cardTitle": {"size": 16, "lineHeight": 24, "weight": 600},
      "body": {"size": 14, "lineHeight": 20, "weight": 400},
      "supporting": {"size": 12, "lineHeight": 16, "weight": 400},
      "button": {"size": 14, "lineHeight": 20, "weight": 600},
      "badge": {"size": 11, "lineHeight": 16, "weight": 600}
    },
    "rules": {
      "allowWrap": true,
      "textScaleSupportPercent": 200,
      "financialNumbers": "tabular figures when available"
    }
  },
  "shape": {
    "extraSmall": 4,
    "small": 8,
    "medium": 12,
    "large": 16,
    "extraLarge": 28,
    "full": 9999,
    "components": {
      "button": "full",
      "chip": "full",
      "badge": "full",
      "textField": "small",
      "card": "medium",
      "walletHero": "large",
      "scanAction": "full",
      "scanFrame": "large",
      "bottomSheet": "extraLarge",
      "dialog": "extraLarge",
      "image": "medium"
    }
  },
  "spacing": {
    "unit": 4,
    "scale": {"0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48},
    "screenPadding": 16,
    "cardPadding": 16,
    "sectionGap": 24,
    "fieldGap": 16,
    "listGap": 12
  },
  "sizing": {
    "touchTargetMin": 48,
    "bottomAppBarHeight": 80,
    "centerScanAction": 72,
    "centerScanIcon": 28,
    "topAppBarSmall": 64,
    "buttonHeight": 48,
    "textFieldHeight": 56,
    "chipHeight": 32,
    "scanFrameWidthFraction": 0.68,
    "productCardImageAspectRatio": "4:3",
    "campaignBannerAspectRatio": "16:9",
    "maxContentWidthExpanded": 1040
  },
  "elevation": {
    "level0": {"dp": 0, "usage": "screen and camera overlay surfaces"},
    "level1": {"dp": 1, "usage": "wallet hero and bottom app bar tonal surface"},
    "level2": {"dp": 3, "usage": "menus and scrolled top app bar"},
    "level3": {"dp": 6, "usage": "center scan action, result surfaces, dialogs and sheets"}
  },
  "motion": {
    "standard": {"durationMs": 300, "curve": "cubic-bezier(0.2, 0, 0, 1)"},
    "enter": {"durationMs": 250, "curve": "cubic-bezier(0, 0, 0, 1)"},
    "exit": {"durationMs": 200, "curve": "cubic-bezier(0.3, 0, 1, 1)"},
    "scanDetected": {"durationMs": 200, "behavior": "pause camera and highlight scan frame once"},
    "scanSuccess": {"durationMs": 350, "behavior": "single success scale/crossfade; respect reduced motion"}
  },
  "components": {
    "bottomAppBar": {
      "leftItems": ["Home", "Products"],
      "centerAction": "Scan",
      "rightItems": ["Wallet", "Profile"],
      "showLabels": "always",
      "respectSafeArea": true
    },
    "scanAction": {
      "component": "FloatingActionButton",
      "placement": "centerDocked",
      "containerRole": "primary",
      "icon": "qr_code_scanner",
      "semanticLabel": "Scan QR"
    },
    "topAppBar": {"type": "small", "actions": ["notifications"]},
    "buttons": {
      "primary": "FilledButton",
      "secondary": "OutlinedButton",
      "tertiary": "TextButton",
      "tonal": "FilledButton.tonal"
    },
    "cards": {
      "walletHero": "Card.filled",
      "scanAction": "Card.filled",
      "scanHistory": "ListTile on surface",
      "transaction": "ListTile on surface",
      "withdrawal": "Card.outlined",
      "product": "Card.outlined",
      "campaign": "Card.filled"
    },
    "feedback": {
      "scanResult": "Full-screen modal surface or large overlay",
      "withdrawalConfirmation": "ModalBottomSheet",
      "criticalConfirmation": "AlertDialog",
      "snackbar": true,
      "progressIndicator": true
    }
  },
  "icons": {
    "style": "Material Symbols Rounded",
    "navigation": {
      "home": "home",
      "products": "category",
      "scan": "qr_code_scanner",
      "wallet": "account_balance_wallet",
      "profile": "person"
