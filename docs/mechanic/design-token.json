      "success": "check_circle",
      "alreadyScanned": "block",
      "notActive": "schedule",
      "invalid": "qr_code_2",
      "expired": "event_busy",
      "offline": "wifi_off",
      "retry": "refresh"
    }
  },
  "contentGuidelines": {
    "currencyFormat": "Rs. X,XXX",
    "phoneFormat": "0300-1234567",
    "dateFormat": "DD MMM YYYY",
    "timeFormat": "HH:mm",
    "tone": "plain, respectful, direct",
    "buttonLabels": "specific verbs; never OK or Submit",
    "maxPrimaryActionsPerScreen": 1,
    "scannerInstruction": "Place the QR inside the frame.",
    "offlineScannerMessage": "Internet is required to scan a QR. Please reconnect and try again.",
    "avoidTerms": ["sync queue", "pending scan", "payload", "signature", "conversion rate", "invoice redemption"]
  },
  "accessibility": {
    "minTouchTargetDp": 48,
    "scanActionMinDp": 64,
    "normalTextContrast": "4.5:1 minimum",
    "largeTextContrast": "3:1 minimum",
    "statusNotColorOnly": true,
    "screenReaderLabelsRequired": true,
    "scanActionSemanticLabel": "Scan QR",
    "supportsTextScale": "up to 200 percent without overlap",
    "keyboardAvoidance": "forms remain usable when IME is open",
    "reducedMotion": "result animations become crossfades"
  }
