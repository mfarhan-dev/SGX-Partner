  "spacing": {
    "unit": 4,
    "scale": {"0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48},
    "screenPadding": 16,
    "cardPadding": 16,
    "sectionGap": 24,
    "fieldGap": 16,
    "listGap": 12
  },
  "sizing": {
    "touchTargetMin": 48,
    "bottomNavHeight": 80,
    "topAppBarSmall": 64,
    "buttonHeight": 48,
    "textFieldHeight": 56,
    "chipHeight": 32,
    "productCardImageAspectRatio": "4:3",
    "campaignBannerAspectRatio": "16:9",
    "progressIndicatorHeight": 8,
    "maxContentWidthExpanded": 1040
  },
  "elevation": {
    "level0": {"dp": 0, "usage": "screen background and flat progress cards"},
    "level1": {"dp": 1, "usage": "wallet hero and navigation tonal surface"},
    "level2": {"dp": 3, "usage": "menus and scrolled top app bar"},
    "level3": {"dp": 6, "usage": "dialogs, bottom sheets, search view"}
  },
  "motion": {
    "standard": {"durationMs": 300, "curve": "cubic-bezier(0.2, 0, 0, 1)"},
    "enter": {"durationMs": 250, "curve": "cubic-bezier(0, 0, 0, 1)"},
    "exit": {"durationMs": 200, "curve": "cubic-bezier(0.3, 0, 1, 1)"},
    "balanceRefresh": {"durationMs": 300, "behavior": "subtle value crossfade, no celebratory motion"},
    "progressRefresh": {"durationMs": 500, "behavior": "animate determinate progress to server value"}
  },
  "components": {
    "navigationBar": {
      "items": ["Home", "QR Progress", "Wallet", "Products", "Profile"],
      "showLabels": "always"
    },
    "topAppBar": {"type": "small", "actions": ["notifications"]},
    "buttons": {
      "primary": "FilledButton",
      "secondary": "OutlinedButton",
      "tertiary": "TextButton",
      "tonal": "FilledButton.tonal"
    },
    "cards": {
      "walletHero": "Card.filled",
      "qrProgress": "Card.outlined non-interactive",
      "transaction": "ListTile on surface",
      "withdrawal": "Card.outlined",
      "product": "Card.outlined",
      "campaign": "Card.filled"
    },
    "feedback": {
      "confirmation": "ModalBottomSheet",
      "criticalConfirmation": "AlertDialog",
      "snackbar": true,
      "progressIndicator": true
    }
  },
  "icons": {
    "style": "Material Symbols Rounded",
    "navigation": {
      "home": "home",
      "qrProgress": "qr_code_2",
      "wallet": "account_balance_wallet",
      "products": "category",
      "profile": "person"
    },
    "actions": {
      "notifications": "notifications",
      "back": "arrow_back",
      "withdraw": "payments",
      "refresh": "refresh",
      "language": "language",
      "theme": "dark_mode",
      "contact": "support_agent",
      "logout": "logout"
    },
    "status": {
      "reward": "add_circle",
      "pending": "schedule",
      "paid": "send",
      "confirmed": "task_alt",
      "disputed": "error",
      "refunded": "currency_exchange",
      "active": "progress_activity",
      "complete": "check_circle"
    }
  },
  "contentGuidelines": {
    "currencyFormat": "Rs. X,XXX",
    "phoneFormat": "0300-1234567",
    "dateFormat": "DD MMM YYYY",
    "timeFormat": "HH:mm",
    "tone": "plain, respectful, direct",
    "buttonLabels": "specific verbs; never OK or Submit",
    "maxPrimaryActionsPerScreen": 1,
    "avoidTerms": ["inventory", "redemption", "payload", "signature", "ledger debit", "conversion rate"]
  },
  "accessibility": {
    "minTouchTargetDp": 48,
    "normalTextContrast": "4.5:1 minimum",
    "largeTextContrast": "3:1 minimum",
    "statusNotColorOnly": true,
    "screenReaderLabelsRequired": true,
    "supportsTextScale": "up to 200 percent without overlap",
    "keyboardAvoidance": "withdrawal form remains usable when IME is open",
    "nonInteractiveQrCards": "must not expose button semantics or tap ripple"
  }
