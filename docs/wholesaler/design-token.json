  "typography": {
    "fontFamily": {
      "default": "Roboto",
      "urduFallback": "Noto Nastaliq Urdu",
      "mono": "Roboto Mono"
    },
    "usage": {
      "screenTitle": {"size": 24, "lineHeight": 32, "weight": 600},
      "sectionTitle": {"size": 16, "lineHeight": 24, "weight": 600},
      "balanceHero": {"size": 32, "lineHeight": 40, "weight": 700},
      "balanceSupporting": {"size": 16, "lineHeight": 24, "weight": 600},
      "cardTitle": {"size": 16, "lineHeight": 24, "weight": 600},
      "body": {"size": 14, "lineHeight": 20, "weight": 400},
      "supporting": {"size": 12, "lineHeight": 16, "weight": 400},
      "button": {"size": 14, "lineHeight": 20, "weight": 600},
      "badge": {"size": 11, "lineHeight": 16, "weight": 600}
    },
    "rules": {
      "maxBodyStylesPerScreen": 4,
      "allowWrap": true,
      "textScaleSupportPercent": 200,
      "financialNumbers": "tabular figures when available"
    }
  },
  "shape": {
    "extraSmall": 4,
    "small": 8,
    "medium": 12,
    "large": 16,
    "extraLarge": 28,
    "full": 9999,
    "components": {
      "button": "full",
      "chip": "full",
      "badge": "full",
      "textField": "small",
      "card": "medium",
      "walletHero": "large",
      "qrProgressCard": "large",
      "bottomSheet": "extraLarge",
      "dialog": "extraLarge",
      "image": "medium"
